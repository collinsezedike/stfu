# Yellowstone gRPC endpoint (e.g. from Helius, Triton, or your own node)
GEYSER_ENDPOINT=https://your-geyser-endpoint.com:443
GEYSER_TOKEN=your_access_token_here

# Solana RPC
RPC_URL=https://api.mainnet-beta.solana.com

# Jito block engine endpoint (mainnet)
JITO_BLOCK_ENGINE_URL=mainnet.block-engine.jito.wtf

# Wallet keypair (base58 encoded private key — never commit this)
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Anthropic API key for the AI tip agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Tip floor in lamports (0.001 SOL default)
TIP_FLOOR_LAMPORTS=1000000
